<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- NVAPI is reached through nvapi64.dll, so the process must be 64-bit. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>simple-nvidia-undervolt</AssemblyName>
    <RootNamespace>SimpleNvidiaUndervolt</RootNamespace>
    <!-- 0.0.0 marks a local/dev build; releases get the real version from the tag (see publish.yml). -->
    <Version>0.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Flat output: build -> bin\, publish -> publish\ (no TFM/RID subfolders). -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishDir>publish</PublishDir>
    <!-- DPI awareness for the interactive message box (see app.manifest). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- App icon; regenerate with assets\render_icon.py. -->
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <!-- 'dotnet publish' produces a standalone native binary (no .NET runtime needed). -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleNvidiaUndervolt.Tests" />
    <InternalsVisibleTo Include="SimpleNvidiaUndervolt.E2E" />
  </ItemGroup>

  <ItemGroup>
    <!-- The active-marker icon; installed next to the exe and referenced by the live profile's .lnk. -->
    <EmbeddedResource Include="..\assets\icon-active.ico" LogicalName="icon-active.ico" />
  </ItemGroup>

</Project>
